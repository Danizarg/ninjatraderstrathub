<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Adaptive Trading Lab" Width="1240" Height="850" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen"
 Background="#10151E" Foreground="#E7EDF6" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#98A7BD"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#192230"/><Setter Property="BorderBrush" Value="#2B384A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E7EDF6"/><Setter Property="Background" Value="#27374C"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderThickness" Value="2"/><Setter TargetName="Shell" Property="BorderBrush" Value="#62E2BD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#10151E"/><Setter Property="Foreground" Value="#E7EDF6"/><Setter Property="BorderBrush" Value="#41516A"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#10151E"/><Setter Property="Padding" Value="9"/><Setter Property="MinWidth" Value="280"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#E7EDF6"/><Setter Property="Padding" Value="20,13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent"><ContentPresenter x:Name="TabHeader" ContentSource="Header" TextElement.Foreground="#98A7BD"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="#62E2BD"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#62E2BD"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#202C3C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#192230"/><Setter Property="Foreground" Value="#E7EDF6"/><Setter Property="RowBackground" Value="#192230"/><Setter Property="AlternatingRowBackground" Value="#1D2939"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#243247"/><Setter Property="Foreground" Value="#B9C8DE"/><Setter Property="Padding" Value="12,11"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,25">
   <Border DockPanel.Dock="Left" Background="#62E2BD" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0"><TextBlock Text="A" Foreground="#10251E" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock x:Name="NtBadge" Text="Checking NinjaTrader…" Foreground="#62E2BD" HorizontalAlignment="Right"/><TextBlock Text="LOCAL WORKSPACE  /  WINDOWS" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="ADAPTIVE TRADING LAB" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Research. Inspect. Test in NinjaTrader." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Your strategy workspace" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Explore lab runs and inspect the executions your NinjaTrader strategy exports." Foreground="{StaticResource Muted}" Margin="0,8,16,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="Refresh" Margin="0,0,10,0"/><Button x:Name="RunButton" Content="▶  Run demo" Background="#62E2BD" Foreground="#10251E" FontWeight="SemiBold"/></StackPanel>
  </Grid>
  <TabControl x:Name="Pages" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,20,0,0">
   <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Background="#20342F" CornerRadius="7" Padding="14,11" Margin="0,0,0,18"><TextBlock Text="DEMO DATA   •   These results are synthetic. Run a NinjaTrader backtest to evaluate the installed strategy." Foreground="#A5DCC7" FontSize="12"/></Border>
    <DockPanel Margin="0,0,0,18"><Button x:Name="OpenRunButton" Content="Open run folder" DockPanel.Dock="Right"/><StackPanel Orientation="Horizontal"><TextBlock Text="LAB RUN" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox x:Name="RunPicker" DisplayMemberPath="Label" MaxWidth="440"/></StackPanel></DockPanel>
    <UniformGrid Columns="4" Margin="0,0,-12,18">
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="NET P&amp;L · SYNTHETIC" Style="{StaticResource Caption}"/><TextBlock x:Name="PnlText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,4" Foreground="#62E2BD"/><TextBlock Text="After reported commission" Style="{StaticResource Caption}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="COMPLETED TRADES" Style="{StaticResource Caption}"/><TextBlock x:Name="CountText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="Records in selected run" Style="{StaticResource Caption}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="WIN RATE" Style="{StaticResource Caption}"/><TextBlock x:Name="WinText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="Trades with positive net P&amp;L" Style="{StaticResource Caption}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MAX DRAWDOWN" Style="{StaticResource Caption}"/><TextBlock x:Name="DrawdownText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="From cumulative net P&amp;L peak" Style="{StaticResource Caption}"/></StackPanel></Border>
    </UniformGrid>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
     <DockPanel><TextBlock Text="Cumulative net P&amp;L" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="SYNTHETIC  /  USD" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
     <TextBlock Text="Closed trades, ordered by exit time. Starting P&amp;L is $0." Style="{StaticResource Caption}" Margin="0,5,0,16"/>
     <Grid Height="205"><Canvas x:Name="EquityCanvas" ClipToBounds="True"/><TextBlock x:Name="ChartEmpty" Text="No runs yet. Click Run demo to create your first result." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    </StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Learning status" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="LearningText" Text="No run selected" Foreground="#F2CA83" Margin="0,10,0,6"/><TextBlock Text="The supplied demo does not train on NinjaTrader execution exports. Its learning engine remains separate." Style="{StaticResource Caption}"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="NinjaTrader strategy" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="ATL_EMA_Trend" Foreground="#62E2BD" Margin="0,10,0,6"/><TextBlock Text="EMA crossover · ADX filter · ATR brackets. Open the NinjaTrader tab for installation and backtest steps." Style="{StaticResource Caption}"/></StackPanel></Border>
    </Grid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Demo trades"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Synthetic trade records from the run selected on Overview. These are not brokerage results." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/><DataGrid x:Name="TradesGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Trade" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Instrument" Binding="{Binding Instrument}" Width="120"/><DataGridTextColumn Header="Exit time" Binding="{Binding ExitLabel}" Width="225"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/><DataGridTextColumn Header="Entry" Binding="{Binding Entry, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Exit" Binding="{Binding Exit, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Net P&amp;L ($)" Binding="{Binding Net, StringFormat=N2}" Width="125"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="NinjaTrader"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Connect your workspace" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Install the native strategy and review the execution files it writes on this computer." Foreground="{StaticResource Muted}" Margin="0,8,0,20"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Installation" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="InstallStatus" Margin="0,10"/>
     <TextBlock Text="NinjaTrader user folder (Documents, not Program Files)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
     <DockPanel><Button x:Name="BrowseNtButton" Content="Browse…" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="NtPathBox"/></DockPanel>
     <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="InstallButton" Content="Install strategy" Background="#62E2BD" Foreground="#10251E"/><Button x:Name="OpenNtButton" Content="Open strategy folder" Margin="10,0,0,0"/></StackPanel>
     <TextBlock Text="A different existing strategy is protected. Updates create a backup before replacing it. Installation does not enable trading." Style="{StaticResource Caption}" Margin="0,14,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Run a historical backtest" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1   In NinjaTrader, open New → NinjaScript Editor and press F5." Margin="0,16,0,10"/><TextBlock Text="2   Open New → Strategy Analyzer and select ATL_EMA_Trend." Margin="0,0,0,10"/><TextBlock Text="3   Choose your instrument, date range and bars, then run the backtest." Margin="0,0,0,10"/><TextBlock Text="4   Return to Executions here and click Refresh to inspect exported fills."/><TextBlock Text="Realtime entries default to OFF. This app does not send orders or control account connections." Foreground="#F2CA83" Margin="0,18,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Executions"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="NinjaTrader execution records" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="Exported fills, including partial fills. These are not paired trades or a P&amp;L report. No network connection is used." Foreground="{StaticResource Muted}" Margin="0,8,0,16"/>
    <DockPanel Grid.Row="2" Margin="0,0,0,14"><Button x:Name="OpenExportsButton" Content="Open exports folder" DockPanel.Dock="Right"/><ComboBox x:Name="ExecutionPicker" DisplayMemberPath="Label" Margin="0,0,14,0"/><TextBlock x:Name="ExecutionCount" VerticalAlignment="Center"/></DockPanel>
    <Grid Grid.Row="3"><DataGrid x:Name="ExecutionsGrid"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="*"/><DataGridTextColumn Header="Instrument" Binding="{Binding Instrument}" Width="135"/><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="110"/><DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="110"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/><DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="100"/></DataGrid.Columns></DataGrid><TextBlock x:Name="ExportsEmpty" Text="No execution files yet. Run the installed strategy in NinjaTrader with Export executions enabled." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" TextAlignment="Center"/></Grid>
   </Grid></TabItem>
   <TabItem Header="Settings &amp; activity"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="Workspace folders" FontSize="24" FontWeight="SemiBold"/>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,18"><StackPanel><TextBlock Text="Demo output folder" Style="{StaticResource Caption}" Margin="0,0,0,6"/><DockPanel><Button x:Name="BrowseOutputButton" Content="Browse…" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="OutputPathBox"/></DockPanel><TextBlock Text="NinjaTrader execution export folder" Style="{StaticResource Caption}" Margin="0,14,0,6"/><DockPanel><Button x:Name="BrowseExportsButton" Content="Browse…" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="ExportPathBox"/></DockPanel><Button x:Name="SaveSettingsButton" Content="Save folders" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
    <TextBlock Grid.Row="2" Text="Activity log" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </Grid></TabItem>
  </TabControl>
  <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource Caption}" VerticalAlignment="Center"/><ProgressBar x:Name="BusyBar" Grid.Column="1" Height="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="#62E2BD" Background="#27374C"/></Grid>
 </Grid>
</Window>
